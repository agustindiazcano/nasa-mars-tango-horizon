{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm -w shared run build && npm -w web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/remote",
      "destination": "/remote.html"
    }
  ]
}
