# Copy this file to .env and fill in the values.
# .env is ignored by git. Never commit secrets or expose API keys in web/.

# --- Server & Security ---
PORT=8080
# Comma-separated list of allowed frontend origins (e.g., https://tango-horizon.vercel.app,https://tango-horizon-xxx.run.app)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MIN=30
LLM_MAX_OUTPUT_TOKENS=400
AGENTS_OFFLINE=0

# --- Frontend (Vercel / Vite) ---
# Leave empty when served from the same origin (local Vite proxy or Cloud Run mirror).
# Set to the Cloud Run backend URL in Vercel project settings (e.g., https://tango-horizon-xxx.a.run.app).
VITE_API_URL=

# --- Google Cloud Project, Vertex AI & Neural Text-to-Speech ---
GCP_PROJECT_ID=nasa-tango-horizon
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1
CLOUD_RUN_SERVICE=tango-horizon
TTS_VOICE_ES=es-US-Journey-D
TTS_VOICE_EN=en-US-Journey-D

# --- Multi-Provider LLM Routing & Failover (Vertex AI + Muse/Meta + Google AI Studio) ---
# Primary provider: "vertex" (GCP Vertex AI keyless ADC), "meta" (Muse/Meta), or "gemini" (Google AI Studio).
# Any remaining configured providers are used automatically as low-latency failover in order.
LLM_PROVIDER=vertex
LLM_FAST_TIMEOUT_MS=4000
LLM_DEFAULT_TIMEOUT_MS=12000

# 1. Google Cloud Vertex AI (Keyless via Application Default Credentials / Cloud Run Service Account on nasa-tango-horizon)
VERTEX_ENABLED=1
VERTEX_MODEL_LARGE=google/gemini-2.5-pro
VERTEX_MODEL_MEDIUM=google/gemini-2.5-flash
VERTEX_MODEL_FAST=google/gemini-2.5-flash
VERTEX_MODEL_JUDGE=google/gemini-2.5-flash
VERTEX_MODEL_VISION=google/gemini-2.5-flash

# 2. Muse / Meta API (OpenAI-compatible)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
LLM_MODEL_LARGE=
LLM_MODEL_MEDIUM=
LLM_MODEL_FAST=
LLM_MODEL_JUDGE=
LLM_MODEL_VISION=

# 3. Google AI Studio / Gemini API (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_LARGE=gemini-2.5-pro
GEMINI_MODEL_MEDIUM=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_JUDGE=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash
