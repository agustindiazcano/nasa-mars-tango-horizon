# Copy this file to .env and fill in the values.
# .env is ignored by git. Never commit secrets or expose API keys in web/.

# --- Server & Security ---
PORT=8080
# Comma-separated list of allowed frontend origins (e.g., https://tango-horizon.vercel.app,https://tango-horizon-xxx.run.app)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MIN=30
LLM_MAX_OUTPUT_TOKENS=400
AGENTS_OFFLINE=0

# --- Frontend (Vercel / Vite) ---
# Leave empty when served from the same origin (local Vite proxy or Cloud Run mirror).
# Set to the Cloud Run backend URL in Vercel project settings (e.g., https://tango-horizon-xxx.a.run.app).
VITE_API_URL=

# --- Dual LLM Provider Configuration (Muse/Meta + Google AI Studio Failover) ---
# Primary provider: "meta" (Muse/Meta) or "gemini" (Google AI Studio). Secondary provider is used automatically on timeout/error.
LLM_PROVIDER=meta
LLM_FAST_TIMEOUT_MS=4000
LLM_DEFAULT_TIMEOUT_MS=12000

# 1. Muse / Meta API (OpenAI-compatible)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
LLM_MODEL_LARGE=
LLM_MODEL_MEDIUM=
LLM_MODEL_FAST=
LLM_MODEL_JUDGE=
LLM_MODEL_VISION=

# 2. Google AI Studio / Gemini API (OpenAI-compatible endpoint + automatic failover)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_LARGE=gemini-2.5-pro
GEMINI_MODEL_MEDIUM=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_JUDGE=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-flash

# --- Google Cloud Run & Neural Text-to-Speech ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=tango-horizon
TTS_VOICE_ES=es-US-Journey-D
TTS_VOICE_EN=en-US-Journey-D
