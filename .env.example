# Copy this file to .env and fill in the values.
# .env is ignored by git. Never commit secrets or expose API keys in web/.

# --- Server & Security ---
PORT=8080
# Comma-separated list of allowed frontend origins (e.g., https://tango-horizon.vercel.app,https://tango-horizon-xxx.run.app)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
RATE_LIMIT_PER_MIN=30
LLM_MAX_OUTPUT_TOKENS=400
AGENTS_OFFLINE=0

# --- Frontend (Vercel / Vite) ---
# Leave empty when served from the same origin (local Vite proxy or Cloud Run mirror).
# Set to the Cloud Run backend URL in Vercel project settings (e.g., https://tango-horizon-xxx.a.run.app).
VITE_API_URL=

# --- Google Cloud Project, Vertex AI & Neural Text-to-Speech ---
GCP_PROJECT_ID=nasa-tango-horizon
GCP_REGION=us-central1
VERTEX_LOCATION=global
CLOUD_RUN_SERVICE=tango-horizon
TTS_VOICE_ES=es-US-Journey-D
TTS_VOICE_EN=en-US-Journey-D

# --- Multi-Provider LLM Routing & Failover (Vertex AI + Google AI Studio + Meta Muse Backup) ---
# Primary provider: "vertex" (GCP Vertex AI keyless ADC), "gemini" (Google AI Studio), or "meta" (Meta Muse backup).
# Remaining enabled providers are used automatically as low-latency failover in order.
LLM_PROVIDER=vertex
LLM_FAST_TIMEOUT_MS=4000
LLM_DEFAULT_TIMEOUT_MS=12000

# 1. Google Cloud Vertex AI (PRIMARY — Keyless via ADC / tango-horizon-sa on nasa-tango-horizon)
# Tiers: Carbon (large/brain), Argon (medium/judge/vision), Hydrogen (fast/lightweight)
VERTEX_ENABLED=1
VERTEX_MODEL_LARGE=google/gemini-4-carbon
VERTEX_MODEL_MEDIUM=google/gemini-4-argon
VERTEX_MODEL_FAST=google/gemini-4-hydrogen
VERTEX_MODEL_JUDGE=google/gemini-4-argon
VERTEX_MODEL_VISION=google/gemini-4-argon

# 2. Google AI Studio / Gemini API (OPTIONAL DIRECT KEY — OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_LARGE=gemini-4-carbon
GEMINI_MODEL_MEDIUM=gemini-4-argon
GEMINI_MODEL_FAST=gemini-4-hydrogen
GEMINI_MODEL_JUDGE=gemini-4-argon
GEMINI_MODEL_VISION=gemini-4-argon

# 3. Meta Muse API (BACKUP — Wonder for brain/large, Spark for fast/lightweight)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
LLM_MODEL_LARGE=muse-wonder-1.0
LLM_MODEL_MEDIUM=muse-wonder-1.0
LLM_MODEL_FAST=muse-spark-1.3
LLM_MODEL_JUDGE=muse-spark-1.3
LLM_MODEL_VISION=muse-wonder-1.0
